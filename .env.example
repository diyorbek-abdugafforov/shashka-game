# ==========================================
# Shashka Platform Environment Configuration
# ==========================================

# Runtime Environment (development | test | production)
NODE_ENV=development

# Application Base URLs
APP_URL=http://localhost:3000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
ADMIN_URL=http://localhost:3001

# Application Ports
API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001

# Telegram Bot Configuration
# Obtain token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCDefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_USERNAME=RussianCheckersBot
# Webhook secret for secure Telegram webhook verification
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_min_32_chars_long

# Database Configuration (PostgreSQL)
POSTGRES_USER=shashka_user
POSTGRES_PASSWORD=shashka_secure_password
POSTGRES_DB=shashka_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://shashka_user:shashka_secure_password@localhost:5432/shashka_db?schema=public

# Redis Configuration (Queue & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Security & Secrets (Must be at least 32 characters in production)
SESSION_SECRET=super_secret_session_key_minimum_32_characters_random
JWT_SECRET=super_secret_jwt_signature_key_minimum_32_characters_random

# Admin Access (Comma-separated Telegram user IDs)
ADMIN_TELEGRAM_IDS=123456789,987654321

# Observability & Monitoring
SENTRY_DSN=https://samplekey@o0.ingest.sentry.io/0
LOG_LEVEL=info
