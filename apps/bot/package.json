{
  "name": "@shashka/bot",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Telegram bot and Mini App launcher for Russian Checkers platform",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/menu": "^1.2.2",
    "@grammyjs/storage-redis": "^2.4.2",
    "@shashka/config": "workspace:*",
    "@shashka/database": "workspace:*",
    "@shashka/shared-types": "workspace:*",
    "@shashka/validation": "workspace:*",
    "fastify": "^5.2.0",
    "grammy": "^1.34.0",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
